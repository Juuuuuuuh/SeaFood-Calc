<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timer</title>
    <style>
        :root { --bg: #eceff1; --card: #ffffff; --primary: #3f51b5; --warn: #f44336; }
        body { font-family: sans-serif; background: var(--bg); display: flex; flex-direction: column; align-items: center; padding: 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; width: 100%; max-width: 1200px; }
        .card { background: var(--card); padding: 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; }
        .time { font-size: 2rem; font-weight: bold; margin: 10px 0; font-family: monospace; }
        .inputs input { width: 45px; padding: 5px; text-align: center; border: 1px solid #ddd; border-radius: 4px; }
        .btns { margin-top: 15px; display: flex; gap: 5px; justify-content: center; }
        button { padding: 8px 12px; border: none; border-radius: 5px; cursor: pointer; color: white; font-weight: bold; }
        .start { background: #4caf50; } .stop { background: #ff9800; } .reset { background: #9e9e9e; }
        .finished { background: #ffebee; animation: blink 1s infinite; }


        .name-input {
            border: none; border-bottom: 1px solid #ddd; text-align: center;
            font-weight: bold; font-size: 1rem; width: 80%; margin-bottom: 5px;
            outline: none;
        }
        .name-input:focus { border-bottom: 1px solid var(--primary); }

        @keyframes blink { 50% { opacity: 0.6; } }
    </style>
</head>
<body>

<h1>Timer</h1>
<p style="color: #666;">'알림 권한'을 허용해야 정상 작동합니다(반박 안받음).</p>
<div class="grid" id="grid"></div>

<audio id="alarmSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto" loop></audio>

<script>
    const grid = document.getElementById('grid');
    const alarmSound = document.getElementById('alarmSound');
    const timers = [];
    const activeBlinks = {}; // 제목 깜빡임 관리를 위한 객체

    //Alert part
    if (Notification.permission !== 'granted' && Notification.permission !== 'denied') {
        Notification.requestPermission();
    }

    function createTimer(i) {
        const card = document.createElement('div');
        card.className = 'card';
        card.id = `c-${i}`;
        card.innerHTML = `
                <div><input type="text" class="name-input" id="n-${i}" value="타이머 ${i+1}"></div>
                <div class="time" id="d-${i}">00:00:00</div>
                <div class="inputs" id="in-${i}">
                    <input type="number" id="h-${i}" placeholder="시">
                    <input type="number" id="m-${i}" placeholder="분">
                    <input type="number" id="s-${i}" placeholder="초">
                </div>
                <div class="btns">
                    <button class="start" onclick="start(${i})">Start</button>
                    <button class="stop" onclick="stop(${i})">Stop</button>
                    <button class="reset" onclick="reset(${i})">Reset</button>
                </div>
            `;
        grid.appendChild(card);
        timers.push({ time: 0, id: null, running: false });
    }

    function start(i) {
        if (timers[i].running) return;
        const h = +document.getElementById(`h-${i}`).value || 0;
        const m = +document.getElementById(`m-${i}`).value || 0;
        const s = +document.getElementById(`s-${i}`).value || 0;
        const name = document.getElementById(`n-${i}`).value; // 이름 가져오기

        if (timers[i].time === 0) timers[i].time = h * 3600 + m * 60 + s;
        if (timers[i].time <= 0) return alert("Time Set");

        timers[i].running = true;
        document.getElementById(`in-${i}`).style.visibility = 'hidden';
        document.getElementById(`n-${i}`).readOnly = true; // 시작 시 이름 수정 방지

        timers[i].id = setInterval(() => {
            timers[i].time--;
            const timeStr = new Date(timers[i].time * 1000).toISOString().substr(11, 8);
            document.getElementById(`d-${i}`).innerText = timeStr;

            if (timers[i].time <= 0) {
                clearInterval(timers[i].id);
                finish(i, name); // 이름 전달
            }
        }, 1000);
    }

    function finish(i, name) {
        timers[i].running = false;
        document.getElementById(`c-${i}`).classList.add('finished');

        // Sound tracking
        alarmSound.play();

        // Alert system console
        if (Notification.permission === 'granted') {
            new Notification(`${name} 종료!`, { body: "Time Out." });
        }

        // blink part
        const oldTitle = "Timer";
        if (activeBlinks[i]) clearInterval(activeBlinks[i]);
        activeBlinks[i] = setInterval(() => {
            document.title = document.title === "종료!!!" ? `${name} 종료!` : "종료!!!";
        }, 500);


    }


    function clearAlarmEffects(i) {

        if (activeBlinks[i]) {
            clearInterval(activeBlinks[i]);
            delete activeBlinks[i];
        }


        const remainingFinished = document.querySelectorAll('.finished').length;
        if (remainingFinished === 0) {
            alarmSound.pause();
            alarmSound.currentTime = 0;
            document.title = "Timer";
        }
    }

    function stop(i) {
        clearInterval(timers[i].id);
        timers[i].running = false;
        document.getElementById(`c-${i}`).classList.remove('finished');
        clearAlarmEffects(i);
    }

    function reset(i) {
        stop(i);
        timers[i].time = 0;
        document.getElementById(`d-${i}`).innerText = "00:00:00";
        document.getElementById(`in-${i}`).style.visibility = 'visible';
        document.getElementById(`c-${i}`).classList.remove('finished');
        document.getElementById(`n-${i}`).readOnly = false;
        clearAlarmEffects(i);
    }

    for (let i = 0; i < 15; i++) createTimer(i);
</script>
</body>
</html>
